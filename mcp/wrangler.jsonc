{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "skillplane-mcp-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat", "allow_eval_during_startup"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.png", "**/*.ico"],
      "fallthrough": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "SKILL_BUNDLES",
      "bucket_name": "skillplane-skill-bundles-local",
      "preview_bucket_name": "skillplane-skill-bundles-local-preview",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
