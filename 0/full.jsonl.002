omment>\\n\\n<file context>\\n@@ -150,64 +45,128 @@ async function token(runtime: OAuthRuntime, request: Request): Promise<Response>\\n+        }),\\n+      refreshToken: (input, request) =>\\n+        fromTokenAuthority(async () => {\\n+          const tokens = await exchangeRefreshToken(runtime, {\\n+            refreshToken: input.refreshToken,\\n+            clientId: input.client.clientId,\\n</file context>\\n```\\n\\n</details>\\n\\n```suggestion\\n          await tokenRateLimit(runtime, input.client.clientId, request);\\n          const tokens = await exchangeRefreshToken(runtime, {\\n```\",\n    \"html_url\": \"https://github.com/21nCo/skillplane/pull/7#discussion_r3885696552\"\n  },\n  {\n    \"id\": 3885696557,\n    \"user\": \"cubic-dev-ai[bot]\",\n    \"created_at\": \"2026-08-29T05:27:19Z\",\n    \"updated_at\": \"2026-08-29T12:44:59Z\",\n    \"path\": \"mcp/package.json\",\n    \"line\": null,\n    \"original_line\": 16,\n    \"commit_id\": \"a767b057d162d8a067f33c21ae9a09a29122cb97\",\n    \"original_commit_id\": \"f61b249b2dd68b2e37ac6a41d1a95f1c2e3e4c94\",\n    \"in_reply_to_id\": null,\n    \"body\": \"<!-- cubic:v=caa37ec4-b246-420c-93fb-45795e983e34 -->\\n<!-- cubic:review-run=cb01c544-8d69-47f1-9759-76fe0b2e2303 -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP2: The added `@mcpfn/*` dependencies use machine-specific `link:` paths that resolve to `/worktrees/superfunctions/MCP-2/...` at the filesystem root. That directory exists only on your local machine, so `pnpm install` fails on a fresh checkout, in CI, and for any other developer, blocking build/typecheck/test until it is manually recreated. The link specifier also carries no version, so pnpm resolves whatever sits at that path at install time; the pinned commit/digest from mcpfn-source.json is only checked when someone manually runs `pnpm mcpfn:verify`, which is not wired into CI or install. Until exact published @mcpfn packages exist, document this as required in CI/onboarding, and wire the `mcpfn:verify` gate into the CI install/verify step so the pin and digest are enforced automatically.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At mcp/package.json, line 16:\\n\\n<comment>The added `@mcpfn/*` dependencies use machine-specific `link:` paths that resolve to `/worktrees/superfunctions/MCP-2/...` at the filesystem root. That directory exists only on your local machine, so `pnpm install` fails on a fresh checkout, in CI, and for any other developer, blocking build/typecheck/test until it is manually recreated. The link specifier also carries no version, so pnpm resolves whatever sits at that path at install time; the pinned commit/digest from mcpfn-source.json is only checked when someone manually runs `pnpm mcpfn:verify`, which is not wired into CI or install. Until exact published @mcpfn packages exist, document this as required in CI/onboarding, and wire the `mcpfn:verify` gate into the CI install/verify step so the pin and digest are enforced automatically.</comment>\\n\\n<file context>\\n@@ -13,6 +13,8 @@\\n     \\\"deploy:check\\\": \\\"wrangler deploy --config wrangler.jsonc --dry-run --outdir dist-worker\\\"\\n   },\\n   \\\"dependencies\\\": {\\n+    \\\"@mcpfn/auth\\\": \\\"link:../../../../worktrees/superfunctions/MCP-2/mcpfn/auth\\\",\\n+    \\\"@mcpfn/core\\\": \\\"link:../../../../worktrees/superfunctions/MCP-2/mcpfn/core\\\",\\n     \\\"@modelcontextprotocol/sdk\\\": \\\"catalog:\\\",\\n</file context>\\n```\\n\\n</details>\\n\\n✅ Addressed in [`f9bc1d8`](https://github.com/21nCo/skillplane/commit/f9bc1d86e76054f6e3d6c11a3082fe5d20235392)\",\n    \"html_url\": \"https://github.com/21nCo/skillplane/pull/7#discussion_r3885696557\"\n  },\n  {\n    \"id\": 3885696560,\n    \"user\": \"cubic-dev-ai[bot]\",\n    \"created_at\": \"2026-08-29T05:27:19Z\",\n    \"updated_at\": \"2026-08-29T07:22:56Z\",\n    \"path\": \".conduct/issue-comple