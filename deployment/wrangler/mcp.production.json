{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skillplane-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.png", "**/*.ico"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mcp.skillplane.dev",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILL_BUNDLES",
      "bucket_name": "skillplane-skill-bundles"
    }
  ],
  "vars": {
    "RUNTIME_ENV": "production",
    "DATABASE_ADAPTER": "postgres",
    "OAUTH_ISSUER": "https://app.skillplane.dev",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
