{
  "name": "@skillplane/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "vitest run --passWithNoTests src",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:security": "vitest run --passWithNoTests tests/security",
    "db:reset:test": "pnpm --filter @skillplane/testing... build && node --enable-source-maps dist/reset-test-database.js",
    "db:backup:verify": "pnpm --filter @skillplane/testing... build && node --enable-source-maps dist/backup-restore.js"
  },
  "dependencies": {
    "authfn": "catalog:",
    "@skillplane/auth": "workspace:*",
    "@skillplane/config": "workspace:*",
    "@skillplane/db": "workspace:*",
    "@skillplane/email": "workspace:*",
    "@skillplane/observability": "workspace:*",
    "@skillplane/storage": "workspace:*",
    "fflate": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
