{
  "name": "@skillplane/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude 'dist/**' src",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:security": "vitest run --passWithNoTests tests/security"
  },
  "dependencies": {
    "@skillplane/observability": "workspace:*",
    "@skillplane/storage": "workspace:*",
    "diff": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
