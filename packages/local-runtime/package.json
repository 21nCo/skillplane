{
  "name": "@skillplane/local-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "skillplane": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude 'dist/**' src",
    "bundle": "node build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@skillplane/domain": "workspace:*",
    "@skillplane/mcp-schema": "workspace:*",
    "@skillplane/storage": "workspace:*",
    "yaml": "2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
