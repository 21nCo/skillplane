{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "skillplane-app-local",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "r2_buckets": [
    {
      "binding": "SKILL_BUNDLES",
      "bucket_name": "skillplane-skill-bundles-local",
      "preview_bucket_name": "skillplane-skill-bundles-local-preview",
    },
  ],
  "vars": {
    "AUTH_MODE": "disabled",
  },
  "observability": {
    "enabled": true,
  },
}
