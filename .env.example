# Skillplane local process configuration.
# `pnpm db:up` writes real local values to ignored runtime files.
RUNTIME_ENV=
DATABASE_ADAPTER=
DATABASE_URL=
AUTH_MODE=disabled
TEST_DATABASE_URL=
MIGRATION_DATABASE_URL=
SKILLPLANE_POSTGRES_PORT=5703

# Production bindings and secrets are configured in Cloudflare, not this file.
CLOUDFLARE_HYPERDRIVE_ID=
SKILLPLANE_PRODUCTION_DATABASE_URL=
SKILLPLANE_PRODUCTION_MIGRATION_SOURCE_DATABASE_URL=
SKILLPLANE_CONTROL_DATABASE_URL=
SKILLPLANE_CELL_IN_SOUTH_DATABASE_URL=
SKILLPLANE_CELL_US_EAST_DATABASE_URL=
CLOUDFLARE_CONTROL_HYPERDRIVE_ID=
CLOUDFLARE_CELL_IN_SOUTH_HYPERDRIVE_ID=
CLOUDFLARE_CELL_US_EAST_HYPERDRIVE_ID=
SKILLPLANE_PUBLIC_BUCKET=skillplane-public-bundles
SKILLPLANE_CELL_IN_SOUTH_BUCKET=skillplane-in-south-bundles
SKILLPLANE_CELL_US_EAST_BUCKET=skillplane-us-east-bundles
SKILLPLANE_RECOVERY_DATABASE_URL=
SKILLPLANE_BACKUP_ENCRYPTION_KEY=
EMAIL_PROVIDER=cloudflare-email
SKILLPLANE_OTP_FROM=Skillplane <no-reply@auth.skillplane.dev>
AUTHFN_SECRET=
OAUTH_TOKEN_PEPPER=
OAUTH_ISSUER=
OAUTH_RESOURCE=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://user.skillplane.dev
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
PUBLIC_TURNSTILE_SITE_KEY=

# Isolated persistent development deployment. Keep real values in the ignored
# `.env.development.local`; production commands do not read that file.
SKILLPLANE_DEV_DATABASE_URL=
CLOUDFLARE_DEV_HYPERDRIVE_ID=
SKILLPLANE_DEV_CONTROL_DATABASE_URL=
SKILLPLANE_DEV_USEAST_DATABASE_URL=
SKILLPLANE_DEV_EUWEST_DATABASE_URL=
CLOUDFLARE_DEV_CONTROL_HYPERDRIVE_ID=
CLOUDFLARE_DEV_CELL_IN_SOUTH_HYPERDRIVE_ID=
CLOUDFLARE_DEV_CELL_US_EAST_HYPERDRIVE_ID=
CLOUDFLARE_DEV_CELL_EU_WEST_HYPERDRIVE_ID=
SKILLPLANE_DEV_PUBLIC_BUCKET=skillplane-public-bundles-dev
SKILLPLANE_DEV_CELL_IN_SOUTH_BUCKET=skillplane-skill-bundles-dev
SKILLPLANE_DEV_CELL_US_EAST_BUCKET=skillplane-us-east-bundles-dev
SKILLPLANE_DEV_CELL_EU_WEST_BUCKET=skillplane-eu-west-bundles-dev
SKILLPLANE_DEV_CLOUDFLARE_API_TOKEN=
SKILLPLANE_PRODUCTION_R2_READ_TOKEN=
SKILLPLANE_DEV_AUTHFN_SECRET=
SKILLPLANE_DEV_OAUTH_TOKEN_PEPPER=
SKILLPLANE_DEV_TURNSTILE_SECRET_KEY=
SKILLPLANE_DEV_WORKSPACE_ROUTING_SECRET=
SKILLPLANE_DEV_BACKUP_ENCRYPTION_KEY=
PUBLIC_DEV_TURNSTILE_SITE_KEY=
# In `.env.development.local`, set PUBLIC_POSTHOG_KEY to the dedicated
# development project token. The deployment supplies it to both app and MCP.

# Stable HTTPS hostnames routed by one named Cloudflare Tunnel to the local
# app (:5700) and MCP (:5701) processes.
SKILLPLANE_LOCAL_APP_URL=
SKILLPLANE_LOCAL_MCP_URL=

# Live production verification inputs. OTP codes and Turnstile/OAuth tokens are
# short-lived and must be supplied only to the verification process.
SKILLPLANE_PRODUCTION_OTP_RECIPIENT=
SKILLPLANE_PRODUCTION_TURNSTILE_TOKEN=
SKILLPLANE_PRODUCTION_OTP_CODE=
SKILLPLANE_PRODUCTION_MCP_ACCESS_TOKEN=
SKILLPLANE_PRODUCTION_WORKSPACE_ID=
SKILLPLANE_PRODUCTION_AGENT_ID=
SKILLPLANE_PRODUCTION_AGENT_NAME=
SKILLPLANE_PRODUCTION_MODEL_PROVIDER=
SKILLPLANE_PRODUCTION_MODEL_NAME=
SKILLPLANE_PRODUCTION_MODEL_VERSION=
SKILLPLANE_RELEASE_TAG=

# Optional read-only local source discovery overrides.
SKILLPLANE_SUPERFUNCTIONS_DEV_ROOT=
SKILLPLANE_SUPERFUNCTIONS_NEXT_ROOT=
SKILLPLANE_NUCLEUS_ROOT=
